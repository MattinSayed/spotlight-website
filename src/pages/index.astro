---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatGrid from "../components/StatGrid.astro";
import FeatureCards from "../components/FeatureCards.astro";
import ImageGrid from "../components/ImageGrid.astro";

const heroStats = [
  { value: "March 2026", label: "first edition" },
  { value: "17 curated films", label: "selected program" },
  { value: "5 continents", label: "represented" },
  { value: "Sold out", label: "80 visitors plus waiting list" }
];

const editionStats = [
  { value: "17 curated films", label: "final program" },
  { value: "30+ submissions", label: "international entries" },
  { value: "5 continents", label: "represented" },
  { value: "80 visitors", label: "in the cinema" },
  { value: "Additional waiting list", label: "extra demand" },
  { value: "Two-hour program", label: "cinema screening" }
];

const aboutCards = [
  { title: "Movement-Based Storytelling", text: "A platform for projects where movement, camera, sound, editing, and space become one cinematic language." },
  { title: "Cinema Attention", text: "A focused setting for dance films that often live online or circulate inside smaller creative communities." },
  { title: "Creative Exchange", text: "A meeting point for dancers, filmmakers, choreographers, musicians, visual artists, and curious audiences." }
];

const visionCards = [
  { kicker: "Up Next", title: "Spring 2027", text: "A larger one-day cinema event in Frankfurt am Main, currently in preparation." },
  { kicker: "Target", title: "Approx. 200-300 Seats", text: "SPOTLIGHT is currently exploring a professional cinema setting with a larger target capacity." },
  { kicker: "Experience", title: "Hosted Festival Format", text: "Curated film blocks with hosting, moderation, awards, interviews, documentation, and community exchange." }
];

const partnerCards = [
  { kicker: "Festival", title: "What SPOTLIGHT Brings", text: "Concept, artistic direction, curation, artist communication, organization, marketing, content production, hosting, and documentation." },
  { kicker: "Value", title: "Why Partner", text: "A shared cinema setting where dance films can be experienced with attention, scale, and an engaged audience beyond online platforms." },
  { kicker: "Audience", title: "Who It Reaches", text: "While SPOTLIGHT is rooted in Frankfurt's creative scene, the festival also attracts artists, guests, and audiences from outside the city through its international film selection and wider creative network." }
];

const gallery = [
  { src: "/images/first-edition-group.jpg", width: 2200, height: 1650, alt: "Artists and filmmakers gathered on stage in front of the SPOTLIGHT projection after the first edition.", caption: "First edition artists and filmmakers" },
  { src: "/images/audience-last-year-professional.jpg", width: 1800, height: 1350, alt: "Audience members watching the SPOTLIGHT first edition inside the cinema while speakers stand near the projected festival logo.", caption: "Audience at the 2026 screening" },
  { src: "/images/team-poster.jpg", width: 1200, height: 1500, alt: "SPOTLIGHT team members Tizian Arnholdt, Samuil Rahman, and Isi Dyson standing with the Dance Film Festival poster outside the cinema.", caption: "Team with the festival poster" },
  { src: "/images/venue-last-year-professional.jpg", width: 1350, height: 1800, alt: "Cinema auditorium with rows of seats and the SPOTLIGHT logo projected on the screen before the first edition.", caption: "Cinema venue before the screening" }
];

const team = ["Isi Dyson", "Mattin Sayed", "Samuil Rahman", "Tizian Arnholdt"];
const contactEmail = "spotlight.filmfestival.germany@gmail.com";
const instagramUrl = "https://www.instagram.com/spotlightfilmfestival?igsh=MTlrMG91YmRsbWw2bw==";
---

<BaseLayout>
  <section id="home" class="hero-section">
    <img class="hero-image" src="/images/hero-cinema-stage.jpg" alt="SPOTLIGHT first edition stage at a Frankfurt cinema with artists, audience members, and the festival logo projected on screen." width="2400" height="1800" fetchpriority="high" decoding="async" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Frankfurt am Main, Germany · Spring 2027 in preparation</p>
      <h1>SPOTLIGHT Dance Film Festival</h1>
      <p class="hero-lede">An independent dance film festival based in Frankfurt am Main, bringing movement-based visual storytelling to the big screen.</p>
      <div class="hero-stats">
        <StatGrid stats={heroStats} />
      </div>
    </div>
  </section>

  <section id="about" class="section editorial-section">
    <div class="section-heading">
      <p class="eyebrow">About</p>
      <h2>Dance film deserves the big screen.</h2>
    </div>
    <div class="editorial-grid">
      <div class="copy">
        <p>SPOTLIGHT Dance Film Festival brings dance film and movement-based visual storytelling into the cinema. SPOTLIGHT creates a shared space where dance films and movement-based projects can be experienced with full attention: on the big screen, together with an audience.</p>
        <p>In a time where many creative works are consumed quickly through social media feeds, dance film can disappear into the speed of scrolling. SPOTLIGHT was created as a counterpoint to that: a physical space where movement-based projects are not just watched in passing, but experienced with attention, sound, scale, and community.</p>
        <p>The festival connects dancers, filmmakers, choreographers, musicians, visual artists, and audiences who are curious about new forms of storytelling. It is a meeting point where creative disciplines overlap, people connect, and new ideas can grow.</p>
        <p>Dance can express identity, create atmosphere, and communicate what words sometimes cannot. Through film, movement, camera, sound, editing, and space come together as a cinematic experience.</p>
        <blockquote>Dance film deserves to be experienced collectively: on the big screen, with full attention.</blockquote>
      </div>
      <div class="image-panel">
        <img src="/images/spotlight-projection.jpg" alt="The SPOTLIGHT logo projected warmly across a cinema screen." width="1200" height="1600" loading="lazy" decoding="async" />
      </div>
    </div>
    <FeatureCards items={aboutCards} />
  </section>

  <section id="edition-2026" class="section proof-section">
    <div class="split-layout">
      <div class="image-panel large">
        <img src="/images/first-edition-group.jpg" alt="Artists and filmmakers on the SPOTLIGHT stage at the sold-out March 2026 first edition." width="2200" height="1650" loading="lazy" decoding="async" />
      </div>
      <div class="copy">
        <p class="eyebrow">First Edition — March 2026</p>
        <h2>A sold-out first edition at Mal Seh'n Kino.</h2>
        <div class="proof-markers" aria-label="First edition key proof points">
          <span><strong>Sold out</strong> 80 visitors plus waiting list</span>
          <span><strong>17 curated films</strong> selected from 30+ submissions</span>
        </div>
        <p>The first edition of SPOTLIGHT took place in March 2026 at Mal Seh'n Kino in Frankfurt am Main. The festival presented a two-hour program of 17 international dance short films and brought together dancers, filmmakers, artists, international guests, and a local creative audience.</p>
        <p>More than 30 films from five continents were submitted. From these submissions, 17 films were selected for the final program.</p>
        <p>The event was completely sold out with 80 visitors and an additional waiting list, showing a strong demand for a dedicated dance film platform in Frankfurt.</p>
      </div>
    </div>
    <StatGrid stats={editionStats} />
    <ImageGrid images={gallery} />
  </section>

  <section id="vision-2027" class="section vision-section">
    <div class="vision-card">
      <div>
        <p class="eyebrow">2027 Vision</p>
        <h2>Coming Spring 2027</h2>
        <p>For the next edition, SPOTLIGHT is planned as a larger one-day cinema event in Frankfurt am Main in spring 2027.</p>
        <p>The 2027 edition is currently in preparation and will build on the success of the first event through a larger cinema setting, stronger partnerships, international networking, and a more developed festival experience.</p>
      </div>
      <div class="poster-card" aria-label="Coming Spring 2027">
        <span>SPOTLIGHT</span>
        <strong>Spring<br />2027</strong>
        <small>Frankfurt am Main</small>
      </div>
    </div>
    <FeatureCards items={visionCards} />
  </section>

  <section id="partners" class="section partners-section">
    <div class="section-heading">
      <p class="eyebrow">For Cinemas & Partners</p>
      <h2>A serious cultural project with a dedicated audience.</h2>
      <p>SPOTLIGHT offers cinemas and cultural partners the opportunity to host a community-driven cultural event with local relevance, international artists, and a wider creative network.</p>
    </div>
    <FeatureCards items={partnerCards} />
    <div class="partner-columns">
      <article class="cooperation-card">
        <h3>Cooperation Models</h3>
        <ul>
          <li>Cinema rental</li>
          <li>Cultural partnership</li>
          <li>Revenue share</li>
          <li>Co-hosted event</li>
          <li>Sponsorship</li>
          <li>Funding partnership</li>
          <li>Media partnership</li>
          <li>Community partnership</li>
        </ul>
      </article>
      <article class="partner-note-card">
        <h3>Reach Statement</h3>
        <p>SPOTLIGHT has access to a broad extended creative network across dance, film, music, and social media. Detailed reach numbers, communication plans, and promotional packages can be shared upon request.</p>
      </article>
      <article class="partner-note-card">
        <h3>Venue Direction</h3>
        <p>The next edition is planned for a professional cinema environment in Frankfurt am Main. SPOTLIGHT is currently exploring suitable cinema and cultural venue partnerships for spring 2027.</p>
      </article>
    </div>
    <div class="cta-band">
      <div>
        <p>Interested in hosting or supporting the 2027 edition?</p>
        <span>We are currently speaking with cinemas, cultural partners, sponsors, and funding bodies for the next edition in Frankfurt am Main.</span>
      </div>
      <a class="button primary" href={`mailto:${contactEmail}`}>Start a conversation</a>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="contact-grid">
      <div>
        <p class="eyebrow">Team & Contact</p>
        <h2>Independent, Frankfurt-based, and ready to talk.</h2>
        <p>SPOTLIGHT was created by an independent team from Frankfurt connected through dance and film. The team brings experience in dance culture, video production, event organization, curation, and community building.</p>
        <p>For partnerships, press, funding, collaborations, and artist inquiries, please contact us.</p>
        <div class="button-row contact-actions">
          <a class="button primary" href={`mailto:${contactEmail}`}>Contact SPOTLIGHT</a>
        </div>
      </div>
      <aside class="contact-card">
        <h3>Team</h3>
        <!-- TODO: Add confirmed team roles once agreed by the team. -->
        <ul class="team-list">
          {team.map((name) => <li>{name}</li>)}
        </ul>
        <div class="contact-lines">
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram: @spotlightfilmfestival</a>
          <span>Frankfurt am Main, Germany</span>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
