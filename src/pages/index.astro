---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatGrid from "../components/StatGrid.astro";
import FeatureCards from "../components/FeatureCards.astro";
import ImageGrid from "../components/ImageGrid.astro";

const heroStats = [
  { value: "March 2026", label: "first edition" },
  { value: "17", label: "curated films" },
  { value: "5", label: "continents represented" },
  { value: "Sold out", label: "80 visitors plus waiting list" }
];

const editionStats = [
  { value: "17", label: "curated dance short films" },
  { value: "30+", label: "international submissions" },
  { value: "5", label: "continents" },
  { value: "80", label: "visitors" },
  { value: "2 hrs", label: "cinema program" },
  { value: "Sold out", label: "with additional waiting list" }
];

const aboutCards = [
  { kicker: "01", title: "Movement-Based Storytelling", text: "A platform for works where movement, camera, sound, editing, and space become one cinematic language." },
  { kicker: "02", title: "Cinema Attention", text: "A focused space for films that often live online or circulate inside smaller creative communities." },
  { kicker: "03", title: "Creative Exchange", text: "A meeting point for dancers, filmmakers, choreographers, musicians, visual artists, and curious audiences." }
];

const visionCards = [
  { kicker: "Spring", title: "2027 Edition", text: "A larger one-day cinema event in Frankfurt am Main, planned with curated film blocks and a developed festival experience." },
  { kicker: "Program", title: "Hosted Festival Format", text: "Hosting, moderation, red carpet interviews, awards, documentation, and community exchange." },
  { kicker: "Growth", title: "Recurring Platform", text: "A step toward a regular Frankfurt-based platform for dance film, artists, and interdisciplinary exchange." }
];

const partnerCards = [
  { kicker: "Festival", title: "What SPOTLIGHT Brings", text: "Concept, artistic direction, curation, artist communication, organization, marketing, content production, hosting, and documentation." },
  { kicker: "Value", title: "Why Partner", text: "Access to new creative audiences, cultural positioning, strong event content, potential press attention, and a credible emerging festival format." },
  { kicker: "Audience", title: "Who It Reaches", text: "Dancers, filmmakers, choreographers, musicians, visual artists, students, young cultural audiences, and Frankfurt creative communities." }
];

const gallery = [
  { src: "/images/first-edition-group.jpg", alt: "Artists and filmmakers gathered on stage in front of the SPOTLIGHT projection after the first edition.", caption: "First edition artists and filmmakers" },
  { src: "/images/community-group.jpg", alt: "Festival participants smiling together on stage in the cinema with the SPOTLIGHT logo behind them.", caption: "Community after the screening" },
  { src: "/images/spotlight-projection.jpg", alt: "Close crop of the projected SPOTLIGHT logo on a cinema screen.", caption: "Projected festival identity" },
  { src: "/images/malsehn-exterior.jpg", alt: "Black and white photo outside Kino MalSehn in Frankfurt am Main.", caption: "MalSehn cinema, Frankfurt" }
];

const team = ["Isi Dyson", "Mattin Sayed", "Samuil Rahman", "Tizian Arnholdt"];
---

<BaseLayout>
  <section id="home" class="hero-section">
    <img class="hero-image" src="/images/hero-cinema-stage.jpg" alt="SPOTLIGHT first edition stage at MalSehn cinema with artists, audience members, and the festival logo projected on screen." />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Frankfurt am Main, Germany</p>
      <h1>SPOTLIGHT Dance Film Festival</h1>
      <p class="hero-lede">A dance film festival connecting dance, film, music, culture, and community.</p>
      <p>SPOTLIGHT is an independent film festival dedicated to dance film and movement-based visual storytelling. After a sold-out first edition in March 2026, SPOTLIGHT is preparing its next edition for spring 2027 in Frankfurt am Main.</p>
      <div class="button-row">
        <a class="button primary" href="#about">Explore the Festival</a>
        <a class="button secondary" href="#partners">Partner With Us</a>
        <a class="button ghost" href="mailto:spotlight.filmfestival.germany@gmail.com">Contact SPOTLIGHT</a>
      </div>
    </div>
    <div class="hero-stats">
      <StatGrid stats={heroStats} />
    </div>
  </section>

  <section id="about" class="section editorial-section">
    <div class="section-heading">
      <p class="eyebrow">About</p>
      <h2>Dance film deserves the big screen.</h2>
    </div>
    <div class="editorial-grid">
      <div class="copy">
        <p>SPOTLIGHT Dance Film Festival is an independent, curated film festival based in Frankfurt am Main, Germany.</p>
        <p>We created SPOTLIGHT to bring dance film and movement-based visual storytelling to the big screen, where these works can be seen, felt, and fully appreciated in a shared cinema setting. Many dance films live online or circulate within smaller creative communities. SPOTLIGHT gives them a focused space where movement, music, visuals, atmosphere, and emotion can unfold with full attention.</p>
        <p>The festival brings together people from different creative worlds: dancers, filmmakers, choreographers, musicians, visual artists, and audiences who are curious about new forms of storytelling.</p>
        <blockquote>Dance film deserves to be experienced collectively — on the big screen, with full attention.</blockquote>
      </div>
      <div class="image-panel">
        <img src="/images/spotlight-projection.jpg" alt="The SPOTLIGHT logo projected warmly across a cinema screen." loading="lazy" />
      </div>
    </div>
    <FeatureCards items={aboutCards} />
  </section>

  <section id="edition-2026" class="section proof-section">
    <div class="split-layout">
      <div class="image-panel large">
        <img src="/images/first-edition-group.jpg" alt="Artists and filmmakers on the SPOTLIGHT stage at the sold-out March 2026 first edition." loading="lazy" />
      </div>
      <div class="copy">
        <p class="eyebrow">First Edition — March 2026</p>
        <h2>A sold-out first edition at MalSehn cinema.</h2>
        <p>The first edition of SPOTLIGHT took place in March 2026 at MalSehn cinema in Frankfurt am Main. The festival presented a two-hour program of 17 international dance short films and brought together dancers, filmmakers, artists, international guests, and a local creative audience.</p>
        <p>More than 30 films from five continents were submitted. From these submissions, 17 films were selected for the final program.</p>
        <p>The event was completely sold out with 80 visitors and an additional waiting list, showing a strong demand for a dedicated dance film platform in Frankfurt.</p>
      </div>
    </div>
    <StatGrid stats={editionStats} />
    <ImageGrid images={gallery} />
  </section>

  <section id="vision-2027" class="section vision-section">
    <div class="vision-card">
      <div>
        <p class="eyebrow">Vision 2027</p>
        <h2>Coming Spring 2027</h2>
        <p>For the next edition, SPOTLIGHT is planned as a larger one-day cinema event in Frankfurt am Main in spring 2027.</p>
        <p>The goal is to develop SPOTLIGHT into a professional and recurring platform for dance film. The 2027 edition will build on the success of the first event and expand the format through a larger venue, stronger partnerships, international networking, and a more developed festival experience.</p>
      </div>
      <div class="poster-card" aria-label="Coming Spring 2027">
        <span>SPOTLIGHT</span>
        <strong>Spring<br />2027</strong>
        <small>Frankfurt am Main</small>
      </div>
    </div>
    <FeatureCards items={visionCards} />
  </section>

  <section id="partners" class="section partners-section">
    <div class="section-heading">
      <p class="eyebrow">For Cinemas & Partners</p>
      <h2>A serious cultural project with a real first audience.</h2>
      <p>SPOTLIGHT offers cinemas and cultural partners the opportunity to host a community-driven cultural event with local relevance and international reach.</p>
    </div>
    <FeatureCards items={partnerCards} />
    <div class="partner-columns">
      <article>
        <h3>Cooperation Models</h3>
        <ul>
          <li>Cinema rental</li>
          <li>Cultural partnership</li>
          <li>Revenue share</li>
          <li>Co-hosted event</li>
          <li>Sponsorship</li>
          <li>Funding, media, or community partnership</li>
        </ul>
      </article>
      <article>
        <h3>Reach Statement</h3>
        <p>SPOTLIGHT has access to a broad extended creative network across dance, film, music, and social media. Detailed reach numbers, communication plans, and promotional packages can be shared upon request.</p>
      </article>
      <article>
        <h3>Venue Direction</h3>
        <p>The next edition is planned for a professional cinema environment in Frankfurt am Main. SPOTLIGHT is currently exploring suitable cinema and cultural venue partnerships for spring 2027.</p>
      </article>
    </div>
    <div class="cta-band">
      <p>Interested in partnering with SPOTLIGHT?</p>
      <a class="button primary" href="mailto:spotlight.filmfestival.germany@gmail.com">Partner With SPOTLIGHT</a>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="contact-grid">
      <div>
        <p class="eyebrow">Team & Contact</p>
        <h2>Independent, Frankfurt-based, and ready to talk.</h2>
        <p>SPOTLIGHT was created by an independent team from Frankfurt connected through dance and film. The team brings experience in dance culture, video production, event organization, curation, and community building.</p>
        <p>For cinema partnerships, funding, press, collaborations, and artist inquiries, please contact us.</p>
        <a class="button primary" href="mailto:spotlight.filmfestival.germany@gmail.com">Contact SPOTLIGHT</a>
      </div>
      <aside class="contact-card">
        <h3>Team</h3>
        <ul class="team-list">
          {team.map((name) => <li>{name}</li>)}
        </ul>
        <div class="contact-lines">
          <a href="mailto:spotlight.filmfestival.germany@gmail.com">spotlight.filmfestival.germany@gmail.com</a>
          <span>Instagram: @yourhandle</span>
          <span>Frankfurt am Main, Germany</span>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
