---
const links = [
  ["About", "#about"],
  ["2026 Edition", "#edition-2026"],
  ["2027 Vision", "#vision-2027"],
  ["Partners", "#partners"],
  ["Contact", "#contact"]
];
const instagramUrl = "https://www.instagram.com/spotlightfilmfestival?igsh=MTlrMG91YmRsbWw2bw==";
---

<header class="site-header" aria-label="Primary navigation">
  <a class="brand" href="#home" aria-label="SPOTLIGHT home">
    <img
      class="brand-logo"
      src="/images/spotlight-logo-header.png"
      width="1200"
      height="614"
      alt="SPOTLIGHT"
    />
  </a>
  <nav class="desktop-nav">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
  <a class="social-link" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="SPOTLIGHT on Instagram">Instagram</a>
  <a class="nav-cta" href="#partners">Partner with us</a>
  <details class="mobile-nav">
    <summary aria-label="Open navigation"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></summary>
    <div class="mobile-nav-panel">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
      <a class="mobile-cta" href="#partners">Partner with us</a>
    </div>
  </details>
</header>
