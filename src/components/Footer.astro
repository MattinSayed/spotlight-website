---
const links = [
  ["Home", "#home"],
  ["About", "#about"],
  ["2026 Edition", "#edition-2026"],
  ["2027 Vision", "#vision-2027"],
  ["Partners", "#partners"],
  ["Contact", "#contact"]
];
const instagramUrl = "https://www.instagram.com/spotlightfilmfestival?igsh=MTlrMG91YmRsbWw2bw==";
---

<footer class="site-footer">
  <div>
    <strong>SPOTLIGHT Dance Film Festival</strong>
    <p>Frankfurt am Main, Germany</p>
    <p>Independent dance film festival connecting movement, image, sound, and community.</p>
    <p class="footer-note">2027 edition in preparation. Venue and program details will be confirmed publicly when finalized.</p>
    <!-- TODO: Add confirmed Impressum details before broad public launch. -->
    <!-- TODO: Add privacy policy before broad public launch. -->
    <p class="footer-legal">Impressum / Datenschutz coming soon</p>
    <a class="footer-social" href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
  </div>
  <nav aria-label="Footer navigation">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
</footer>
