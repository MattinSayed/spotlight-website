---
const links = [
  ["Home", "#home"],
  ["About", "#about"],
  ["2026 Edition", "#edition-2026"],
  ["Vision 2027", "#vision-2027"],
  ["Partners", "#partners"],
  ["Contact", "#contact"]
];
---

<footer class="site-footer">
  <div>
    <strong>SPOTLIGHT Dance Film Festival</strong>
    <p>Frankfurt am Main, Germany</p>
    <p>Independent dance film festival connecting movement, image, sound, and community.</p>
  </div>
  <nav aria-label="Footer navigation">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
</footer>
