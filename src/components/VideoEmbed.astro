---
const {
  title,
  description,
  youtubeId,
  fallbackUrl,
  label,
  aspectRatio = "9 / 16",
  variant = "feature",
  headingTag = "h2"
} = Astro.props;

const embedUrl = `https://www.youtube.com/embed/${youtubeId}`;
const className = `video-feature video-feature--${variant}`;
const HeadingTag = headingTag;
---

<article class={className} style={`--video-aspect: ${aspectRatio};`}>
  <div class="video-copy">
    {label && <p class="video-label">{label}</p>}
    <HeadingTag class="video-title">{title}</HeadingTag>
    <p>{description}</p>
    <a class="video-link" href={fallbackUrl} target="_blank" rel="noopener noreferrer">Open video on YouTube</a>
  </div>
  <div class="video-card">
    <div class="video-frame">
      <iframe
        src={embedUrl}
        title={title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
  </div>
</article>
